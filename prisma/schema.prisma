// W1D2-BE: Prisma schema for the club database (Azure PostgreSQL).
// Tables are added in W1D3 (part 1), W1D4 (part 2) and W1D5 (part 3).
// The connection URL is set in prisma.config.ts, which reads DATABASE_URL from .env.
// Change tables only through Prisma migrations, committed with the task.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// W1D3-BE: Member accounts and project records before the first migration.
enum UserRole {
  member
  officer

  @@map("user_role")
}

// The same person can be a lead on one project and a member on another.
enum ProjectRole {
  member
  lead

  @@map("project_role")
}

model User {
  id           Int             @id @default(autoincrement())
  name         String
  email        String          @unique
  passwordHash String          @map("password_hash")
  role         UserRole        @default(member)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships  ProjectMember[]

  // W1D4-BE: a task points at two users, so each list names its relation.
  assignedTasks Task[]        @relation("TaskAssignee")
  createdTasks  Task[]        @relation("TaskCreator")
  meetingNotes  MeetingNote[]
  attendance    Attendance[]

  // W1D5-BE: RSVP answers, expenses this officer recorded, reminders sent to them.
  rsvpResponses    RsvpResponse[]
  recordedExpenses Expense[]
  notifications    NotificationLog[]

  @@map("users")
}

model Project {
  id        Int       @id @default(autoincrement())
  title     String
  summary   String
  status    String
  imageUrl  String?   @map("image_url")
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // New projects start private. Archiving keeps their history.
  isPublic Boolean @default(false) @map("is_public")
  archived Boolean @default(false)

  members  ProjectMember[]
  overview ProjectOverview?
  tasks    Task[]
  events   Event[]
  expenses Expense[]

  @@map("projects")
}

model ProjectMember {
  projectId   Int         @map("project_id")
  userId      Int         @map("user_id")
  projectRole ProjectRole @default(member) @map("project_role")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  // The same user can join a project once. The user index helps list their projects.
  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectOverview {
  // Using the project ID as the key gives each project at most one overview.
  projectId   Int     @id @map("project_id")
  goals       String?
  plan        String?
  budgetNotes String? @map("budget_notes")
  risks       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@map("project_overviews")
}

// W1D4-BE: calendar, activities, tasks, meeting notes and attendance.

// The plan's four event types. The calendar shows each one as a text label.
enum EventType {
  conference
  competition
  general_meeting
  project_meeting

  @@map("event_type")
}

enum AttendanceStatus {
  present
  absent

  @@map("attendance_status")
}

model Event {
  id    Int       @id @default(autoincrement())
  title String
  type  EventType

  // timestamptz stores the exact moment in UTC; pages show it in Pacific time.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  // Optional: an online or not-yet-booked event has no place yet.
  location String?

  // Optional: a general meeting or conference belongs to no project.
  projectId Int?     @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  meetingNotes  MeetingNote[]
  attendance    Attendance[]
  rsvpForm      RsvpForm?
  notifications NotificationLog[]

  // startsAt: the calendar and the reminder job search by start time.
  @@index([startsAt])
  @@index([projectId])
  @@map("events")
}

model Activity {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  // A past activity happened on a day, so this is a date without a time.
  date        DateTime @db.Date
  // Optional until the photo upload exists (W3D3-BE).
  imageUrl    String?  @map("image_url")

  @@map("activities")
}

model Task {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  title       String
  description String?
  // Text until the team agrees on the allowed values, like Project.status.
  status      String
  dueDate     DateTime? @map("due_date") @db.Date

  // The assignee does the work and can be empty until an officer assigns it.
  // The creator is the officer who made the task and never changes.
  assigneeId  Int? @map("assignee_id")
  createdById Int  @map("created_by")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee  User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy User    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // Indexes for "this project's tasks" and "my tasks".
  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model MeetingNote {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  content   String
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Restrict: an event with notes can't be deleted until its notes are handled.
  event  Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@map("meeting_notes")
}

model Attendance {
  eventId Int              @map("event_id")
  userId  Int              @map("user_id")
  status  AttendanceStatus

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  // One attendance row per person per event, like ProjectMember.
  @@id([eventId, userId])
  @@index([userId])
  @@map("attendance")
}

// W1D5-BE: RSVP forms, expenses, budget and the reminder log.

// Enum values can't start with a digit, so "30 min" / "5 min" are spelled out.
enum NotificationKind {
  thirty_minutes
  five_minutes

  @@map("notification_kind")
}

model RsvpForm {
  id        Int       @id @default(autoincrement())
  // @unique: an event has at most one RSVP form (architecture, "How the tables connect").
  eventId   Int       @unique @map("event_id")
  title     String
  // The questions an officer adds, e.g. [{"label": "Dietary needs?", "type": "text"}].
  questions Json
  // Optional: without a closing time the form stays open.
  closesAt  DateTime? @map("closes_at") @db.Timestamptz(3)

  event     Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  responses RsvpResponse[]

  @@map("rsvp_forms")
}

model RsvpResponse {
  id        Int      @id @default(autoincrement())
  formId    Int      @map("form_id")
  userId    Int      @map("user_id")
  // Answers in the same order as the form's questions.
  answers   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  form RsvpForm @relation(fields: [formId], references: [id], onDelete: Restrict)
  user User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  // One response per user per form. The user index helps list "my RSVPs".
  @@unique([formId, userId])
  @@index([userId])
  @@map("rsvp_responses")
}

model Expense {
  id          Int      @id @default(autoincrement())
  // The day the money was spent, so a date without a time.
  date        DateTime @db.Date
  // Whole cents, never decimals: $12.50 is stored as 1250.
  amountCents Int      @map("amount_cents")
  // Text until the team agrees on the categories, like Project.status.
  category    String
  description String
  // Optional until the receipt upload exists (W4D3-BE).
  receiptUrl  String?  @map("receipt_url")

  // Optional: some spending belongs to the whole club, not one project.
  projectId    Int? @map("project_id")
  // The officer who logged the expense.
  recordedById Int  @map("recorded_by")

  // Archived instead of deleted, so past budget totals stay correct.
  archived Boolean @default(false)

  project    Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  // Indexes for "spending per project" and "spending in a date range (term)".
  @@index([projectId])
  @@index([date])
  @@map("expenses")
}

model Budget {
  id         Int    @id @default(autoincrement())
  // A label such as "2026-fall". @unique: one budget per term.
  term       String @unique
  totalCents Int    @map("total_cents")

  @@map("budget")
}

model NotificationLog {
  eventId Int              @map("event_id")
  userId  Int              @map("user_id")
  kind    NotificationKind
  sentAt  DateTime         @default(now()) @map("sent_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  // The key is event + user + kind, so the reminder job can't send the same
  // reminder twice, even if the timer runs late or twice (architecture, "Notifications").
  @@id([eventId, userId, kind])
  @@index([userId])
  @@map("notification_log")
}
