# W1D1-BE lists environment variables for local development.
# W1D2-BE documents the Azure PostgreSQL connection string format.
# Put credentials in an ignored .env file at the project root.
# Never put a secret in a NEXT_PUBLIC_ variable.

# Azure Database for PostgreSQL (Flexible Server), used by Prisma.
# Format: postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/DBNAME?sslmode=require
# Azure requires SSL, so keep ?sslmode=require. URL-encode special characters in the password.
DATABASE_URL=

# Signs login tokens (jose). Use a long random string.
JWT_SECRET=

# Secret header value for POST /api/cron/reminders (Azure Functions timer).
CRON_SECRET=
